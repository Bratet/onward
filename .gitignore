# Your data: resumes, applications, state and personal config. It is never part
# of the code repo; keep it in its own private repository if you want history.
/workspace/
.env

# Generated (renderCV intermediates)
rendercv_output/

# OS
.DS_Store
*.mov
*.mp4

# Claude Code local
.claude/settings.local.json

# Impeccable design tool. The design sidecar (design.json), surface briefs and
# critique snapshots are tracked so design progress follows the repo across
# devices; keep real application details out of them, since the repo is public.
# Machine-local state stays out: live-mode logs, review screenshots of real
# data, the hook cache, decision-page scratch and local config.
.impeccable/config.local.json
.impeccable/hook.cache.json
.impeccable/live/
.impeccable/review/
.impeccable/questions/

# Python
__pycache__/

# Node / Next.js (this repo now hosts a Next app)
node_modules/
.next/
.next-desktop/
# Desktop app build output
/desktop/build/
/desktop/dist/
/desktop/node_modules/
out/
next-env.d.ts
*.tsbuildinfo
.npmrc

# Local app state the tests or a demo run write into the example workspace
examples/workspace/state/settings.json
examples/workspace/state/claude-models.json
examples/workspace/state/codex-models.json
examples/workspace/state/goal.json
examples/workspace/state/.trash/
examples/workspace/state/runs/
examples/workspace/state/chats/
examples/workspace/state/workspaces/

# Scratch render previews (not application output)
/tmp/
