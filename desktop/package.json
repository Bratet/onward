{
  "name": "onward-desktop",
  "productName": "Onward",
  "version": "0.1.0",
  "description": "Your job application companion, as a desktop app.",
  "author": "Bratet",
  "license": "MIT",
  "homepage": "https://github.com/Bratet/onward",
  "private": true,
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "server": "node scripts/build-server.mjs",
    "start": "electron .",
    "dist": "node scripts/build-server.mjs && electron-builder --publish never",
    "release": "node scripts/build-server.mjs && electron-builder --publish always"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "electron": "^45.0.0",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "io.github.bratet.onward",
    "productName": "Onward",
    "artifactName": "Onward-${version}-${os}-${arch}.${ext}",
    "directories": { "output": "dist" },
    "files": ["main.mjs", "preload.cjs", "lib/**", "onboarding/**", "package.json"],
    "extraResources": [{ "from": "build", "to": ".", "filter": ["server/**/*"] }],
    "publish": [{ "provider": "github", "owner": "Bratet", "repo": "onward", "releaseType": "draft" }],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ]
    },
    "win": { "target": [{ "target": "nsis", "arch": ["x64"] }] },
    "nsis": { "oneClick": true, "perMachine": false },
    "linux": {
      "category": "Office",
      "maintainer": "Bratet",
      "target": [
        { "target": "AppImage", "arch": ["x64"] },
        { "target": "deb", "arch": ["x64"] }
      ]
    }
  }
}
